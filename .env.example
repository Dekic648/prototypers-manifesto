# Copy to .env.local and fill in. Needed only to work on the suggestions and
# voting features — the manifesto itself renders fine without any of this.
#
# Note: `vercel env pull` returns EMPTY values for the Supabase Marketplace
# variables, so copy them by hand from the Supabase dashboard instead:
#   Project Settings -> API Keys

# Project URL, e.g. https://abcdefghijklm.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# The anon / publishable key. PUBLIC by design — it ships in the browser bundle.
# Row Level Security is what constrains it, not secrecy.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# The service_role / secret key. BYPASSES every RLS policy: it is the only
# credential that can read pending suggestions and approve them.
# Server-side only. Never prefix it with NEXT_PUBLIC_. Never commit it.
SUPABASE_SERVICE_ROLE_KEY=


# --- Notifications (optional) ------------------------------------------------
# Only needed if you want a GitHub issue opened when a suggestion arrives.
# Without both of these, /api/suggestions/notify returns 501 and does nothing.

# Shared secret. The Supabase Database Webhook sends it as the
# `x-manifesto-webhook-secret` header; the route compares it in constant time.
# Generate one with: openssl rand -hex 32
SUGGESTION_WEBHOOK_SECRET=

# Fine-grained GitHub PAT, scoped to this repository, with
# Repository permissions -> Issues: Read and write. Nothing else.
GITHUB_TOKEN=

# Override only if the repo moves.
# GITHUB_REPO=Dekic648/prototypers-manifesto


# --- Moderation --------------------------------------------------------------
# Comma-separated GitHub logins allowed to reach /admin and approve or reject.
# Defaults to the repository owner, so a fresh deploy is never locked out.
# ADMIN_GITHUB_LOGINS=Dekic648
